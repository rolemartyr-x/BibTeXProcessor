{
	"name": "BibTeXProcessor",
	"version": "1.4.1",
	"description": "My take on the Bibliosidian plug-in to add frontmatter to pages.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --import ./tests/setup.mjs --test",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "rolemartyr-x",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"builtin-modules": "3.3.0",
		"esbuild": "0.28.1",
		"obsidian": ">=1.5.7",
		"typescript": "4.7.4"
	},
	"overrides": {
		"moment": "2.31.0"
	}
}
